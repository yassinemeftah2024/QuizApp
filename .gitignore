# ==========================
# QuizApp Root .gitignore
# ==========================

# IDE & Editors
.idea/
*.iml
.vscode/
*.swp
*.swo

# System
.DS_Store
Thumbs.db
desktop.ini

# Environment variables
.env
.env.local
.env.*.local

# Logs
*.log

# Backend build artifacts
backend/target/
backend/.mvn/
backend/*.jar

# Frontend build artifacts & dependencies
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.nx/

# PDF/Temp extraction artifacts
read_pdf*.py
extracted_*.txt
